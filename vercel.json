{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/buscar-endereco", "destination": "/api/cep" },
    { "source": "/pagamento/:path*", "destination": "https://futysxjtptcsahgyrpci.supabase.co/functions/v1/primecash/:path*" },
    { "source": "/api/primecash/:path*", "destination": "https://futysxjtptcsahgyrpci.supabase.co/functions/v1/primecash/:path*" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/loja", "destination": "/produto.html" },
    { "source": "/checkout", "destination": "/checkout.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
